# Cloud STT (OpenAI) - required, this is now the only transcription engine
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Limits
MAX_DURATION_SECONDS=7200
MAX_UPLOAD_MB=500
MAX_JOBS_PER_HOUR_PER_IP=5

# Session signing secret - REQUIRED in production. Generate a long random
# value, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Emails (comma-separated) auto-promoted to the admin role on register/login.
# This is the only way to bootstrap the first admin account.
ADMIN_EMAILS=

# Wallet / pricing
# Per-job price is tiered by media duration - see app/pricing.py's TIERS
# list to change the price table (not an env var, since it's a whole table
# rather than a single number).
MIN_TOPUP_VND=10000

# Manual bank-transfer top-up - no payment gateway account needed. The app
# shows customers a VietQR code (a free public QR standard) pointing at this
# bank account; an admin then manually confirms the transfer arrived and
# credits the wallet from the admin panel (/admin).
# BANK_ID: VietQR bank short code or BIN, e.g. "vietcombank" or "970436" -
# see https://api.vietqr.io/v2/banks for the full list.
BANK_ID=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=

# Paths to Netscape-format cookies.txt files for yt-dlp. Needed on hosts
# whose IP gets bot-detection blocked by TikTok/Facebook (common on cloud
# hosting). On Render, add each file via Environment > Secret Files and
# point these at their mounted paths (e.g. /etc/secrets/cookies.txt).
# Keep TikTok's and YouTube's cookies in SEPARATE files - merging them into
# one cookies.txt was found to break TikTok's extraction. YTDLP_COOKIES_FILE
# is used for every site except YouTube when YTDLP_COOKIES_FILE_YOUTUBE is set.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FILE_YOUTUBE=
