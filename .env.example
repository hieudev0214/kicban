# Local STT (faster-whisper)
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# Cloud STT (OpenAI) - optional; leave blank to disable the OpenAI engine option in the UI
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# Limits
MAX_DURATION_SECONDS=7200
MAX_UPLOAD_MB=500
MAX_JOBS_PER_HOUR_PER_IP=5

# Path to a Netscape-format cookies.txt for yt-dlp. Needed on hosts whose IP
# gets bot-detection blocked by YouTube/TikTok (common on cloud hosting).
# On Render, add the file via Environment > Secret Files and point this at
# its mounted path (e.g. /etc/secrets/cookies.txt).
YTDLP_COOKIES_FILE=
